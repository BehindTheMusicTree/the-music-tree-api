meta {
  name: Outlaw parent Country
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}genres/
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenAccess}}
}

body:json {
  {
    "name": "Outlaw",
    "parent": "{{genreCountryUuid}}"
  }
}

vars:post-response {
  genreOutlawUuid: res.body.uuid
}
