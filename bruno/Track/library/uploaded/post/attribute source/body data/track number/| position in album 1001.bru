meta {
  name: | position in album 1001
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}library/uploaded/
  body: multipartForm
  auth: inherit
}

headers {
  : 
}

body:multipart-form {
  file: @file(api/test/utils/uploaded_track/files/metadata=none.mp3)
  positionInAlbum: 1001
  albumName: album stylax
}

vars:post-response {
  libTrackHorsesUuid: res.body.uuid
  genreOutlawUuid: res.body.genre.uuid
  genreOutlawPlaylistUuid: res.body.playlists[0].uuid
  title: horses
}
