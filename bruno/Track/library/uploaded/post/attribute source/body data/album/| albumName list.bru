meta {
  name: | albumName list
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}library/uploaded/
  body: multipartForm
  auth: inherit
}

headers {
  : 
}

body:multipart-form {
  file: @file(api/test/utils/uploaded_track/files/metadata=none.mp3)
  artistsNames: mat
  albumName: bo
  albumArtistsNames: muse
}

vars:post-response {
  artistMatUuid: res.body.artists[0].uuid
  albumBoUuid: res.body.album.uuid
}
