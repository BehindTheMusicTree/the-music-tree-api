meta {
  name: tracks--uuid-
  type: http
  seq: 1
}

put {
  url: {{BASE_URL}}tracks/{{trackUuid}}/
  body: json
  auth: bearer
}

headers {
  Authorization: {{authorization}}
}

auth:bearer {
  token: {{tokenAccess}}
}

body:json {
  {
    "title": "Somewhere I Belong",
    "artist_name": "4",
    "album_name": "jujo",
    "album_artists_names": "Artist9, Artist8",
    "genre": "{{genre_uuid}}",
    "rating": 200,
    "language": "English"
  }
}
