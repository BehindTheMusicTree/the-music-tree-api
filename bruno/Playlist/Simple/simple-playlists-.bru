meta {
  name: simple-playlists-
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}playlists/simple/
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tokenAccess}}
}

body:multipart-form {
  name: stylax
}

tests {
  var jsonData = JSON.parse(responseBody)
  bru.setEnvVar("playlistUuid", jsonData.results[0].uuid)
}
