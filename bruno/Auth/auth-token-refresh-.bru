meta {
  name: auth-token-refresh-
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}auth/token/refresh/
  body: json
  auth: none
}

body:json {
  {
      "refresh": "{{tokenRefresh}}"
  }
}

script:pre-request {
