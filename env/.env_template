DOCKERHUB_USERNAME=***

ENV=DEV
DEBUG=true
AUDIO_META_ANALYSE_IS_NEEDED=true
APP_IS_EXPOSED=false
ACOUSTID_API_KEY=***
DB_IS_NEEDED=true
MEDIA_DEFAULT_INTERNAL_DIR=media/
LIBRARIES_DIR_NAME=libraries
STATIC_FILES_ARE_NEEDED=true
STATIC_FILES_DEFAULT_INTERNAL_DIR=static-files/
TMP_UPLOADED_FILES_DEFAULT_INTERNAL_DIR=tmp-uploaded-files/
DJANGO_LOGS_ARE_NEEDED=true
DJANGO_LOG_DEFAULT_INTERNAL_DIR=log/
DJANGO_LOG_GENERAL_FILENAME=general.log
DJANGO_LOG_INFO_FILENAME=info.log
DJANGO_LOG_REQUESTS_FILENAME=requests.log
DJANGO_LOG_REQUESTS_DEBUG_FILENAME=requests.debug.log
DJANGO_LOG_EXCEPTIONS_FILENAME=exceptions.log
DJANGO_LOG_DJANGO_FILENAME=django.log
DJANGO_LOG_APP_FILENAME=app.log

DB_CONTAINER_NAME=DB
DB_SUPERUSER_NAME=***
DB_SUPERUSER_PASSWORD='***'
DB_BODZIFY_API_DB_NAME=***
DB_BODZIFY_API_USERNAME=***
DB_BODZIFY_API_USER_PASSWORD='***'
DB_HOST=localhost
DB_PORT=***
